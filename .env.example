# Copy to .env and fill in real values. Never commit .env.

# ── Database ──────────────────────────────────────────────
# Credentials below are consumed by docker-compose.yml and must match DATABASE_URL.
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=resume_db
DATABASE_URL=postgresql+asyncpg://admin:change-me@localhost:5432/resume_db

# ── Auth ──────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production
ADMIN_EMAILS=["admin@example.com"]

# ── LLM provider ──────────────────────────────────────────
# "google" (default, per agents.yaml) | "openai"
LLM_PROVIDER=google
MAX_LLM_CONCURRENCY=4

GOOGLE_API_KEY=
GOOGLE_FLASH_MODEL=gemini-2.0-flash
GOOGLE_FLASH_LITE_MODEL=gemini-2.0-flash-lite

OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_SMART_MODEL=gpt-4o

# ── Observability (optional) ──────────────────────────────
# Leave this false unless you are debugging. Setting it true uploads the full
# prompt and response of EVERY LangChain call to api.smith.langchain.com, which
# for this project means complete resume text: name, email, phone, employers
# and every bullet. It is not limited to the @traceable-decorated functions.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=resume_builder
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ── Server ────────────────────────────────────────────────
# Set false in any deployed environment: hides tracebacks from API responses
# and enforces a non-default JWT_SECRET_KEY.
DEBUG=true
# JSON list of browser origins allowed to call the API.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
